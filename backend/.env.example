# BioLitEvidence Finder backend configuration
# Copy this file to .env and fill in the values you actually want to use.

# OpenAI-compatible Chat / LLM API
LLM_API_BASE_URL=https://uni-api.cstcloud.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# OpenAI-compatible Embedding API (optional)
# If empty, the system will try local sentence-transformers, then fall back
# to keyword-only search.
EMBEDDING_API_BASE_URL=https://uni-api.cstcloud.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:8b

# Optional: external DeepSeek-OCR endpoint (multipart upload)
DEEPSEEK_OCR_URL=
DEEPSEEK_OCR_KEY=

# Storage
DATA_DIR=../data
DB_PATH=../data/app.db

# Page rendering
PAGE_IMAGE_DPI=144

# Chunking
CHUNK_TOKENS=480
CHUNK_OVERLAP=60
