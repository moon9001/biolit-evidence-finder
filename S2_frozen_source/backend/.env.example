# BioLitEvidence Finder backend configuration.
# Copy this file to `.env` and fill in only the values you actually need.
# Every section below is OPTIONAL; the system runs fine with an empty file.

# -----------------------------------------------------------------------------
# LLM (chat / extraction) - any OpenAI-compatible endpoint
# -----------------------------------------------------------------------------
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Examples:
#   LLM_API_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-v4-flash
#   LLM_API_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Embedding (semantic search) - any OpenAI-compatible endpoint
# -----------------------------------------------------------------------------
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# If empty the system tries local sentence-transformers, then falls back to
# keyword + full-text search only. Examples:
#   EMBEDDING_API_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Optional: external DeepSeek-OCR endpoint (multipart upload, async)
# -----------------------------------------------------------------------------
DEEPSEEK_OCR_URL=
DEEPSEEK_OCR_KEY=

# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------
DATA_DIR=../data
DB_PATH=../data/app.db
PAGE_IMAGE_DPI=144

# -----------------------------------------------------------------------------
# Database (advanced)
# -----------------------------------------------------------------------------
# By default a SQLite file at DB_PATH is used. To use another database,
# set DATABASE_URL to any SQLAlchemy-compatible URL, for example:
#   DATABASE_URL=postgresql+psycopg://user:pass@host/biolit
# When DATABASE_URL is set, DB_PATH is ignored.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------
CHUNK_TOKENS=480
CHUNK_OVERLAP=60
